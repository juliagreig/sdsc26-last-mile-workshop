   {
    "id": "n-loading-reproject",
    "type": "generic",
    "position": {
     "x": 272,
     "y": 760
    },
    "data": {
     "name": "native.customsql",
     "version": "2.0.0",
     "title": "1. Convert coordinates",
     "label": "Custom SQL Select",
     "inputs": [
      {
       "name": "sourcea",
       "title": "Source table a",
       "type": "Table",
       "value": null
      },
      {
       "name": "sourceb",
       "title": "Source table b",
       "type": "Table",
       "value": null
      },
      {
       "name": "sourcec",
       "title": "Source table c",
       "type": "Table",
       "value": null
      },
      {
       "name": "sql",
       "title": "SQL SELECT statement",
       "type": "StringSql",
       "value": "WITH p AS (\n  SELECT order_number, on_street, from_street, to_street, sign_description,\n    SAFE_CAST(sign_x_coord AS FLOAT64) * 0.3048006096012192 - 300000.0 AS dx,\n    7462536.301142955 - SAFE_CAST(sign_y_coord AS FLOAT64) * 0.3048006096012192 AS dy\n  FROM `$a`\n  WHERE SAFE_CAST(sign_x_coord AS FLOAT64) IS NOT NULL AND SAFE_CAST(sign_y_coord AS FLOAT64) IS NOT NULL\n), r AS (\n  SELECT *, POW(SQRT(dx*dx + dy*dy) / 12287232.615120513, 1.0/0.6540820912037886) AS t, ATAN2(dx, dy)/0.6540820912037886 + (-1.2915436464758039) AS lam FROM p\n), s_p0 AS (SELECT *, ACOS(-1)/2 - 2*ATAN(t) AS p0 FROM r),\ns_p1 AS (SELECT *, ACOS(-1)/2 - 2*ATAN(t*POW((1-0.08181919104281579*SIN(p0))/(1+0.08181919104281579*SIN(p0)), 0.08181919104281579/2)) AS p1 FROM s_p0),\ns_p2 AS (SELECT *, ACOS(-1)/2 - 2*ATAN(t*POW((1-0.08181919104281579*SIN(p1))/(1+0.08181919104281579*SIN(p1)), 0.08181919104281579/2)) AS p2 FROM s_p1),\ns_p3 AS (SELECT *, ACOS(-1)/2 - 2*ATAN(t*POW((1-0.08181919104281579*SIN(p2))/(1+0.08181919104281579*SIN(p2)), 0.08181919104281579/2)) AS p3 FROM s_p2),\ns_p4 AS (SELECT *, ACOS(-1)/2 - 2*ATAN(t*POW((1-0.08181919104281579*SIN(p3))/(1+0.08181919104281579*SIN(p3)), 0.08181919104281579/2)) AS p4 FROM s_p3)\nSELECT order_number, on_street, from_street, to_street, sign_description,\n  CASE WHEN UPPER(sign_description) LIKE '%TRUCK%' THEN 'Truck Loading Zone'\n       WHEN UPPER(sign_description) LIKE '%NLZ%' OR UPPER(sign_description) LIKE '%NEIGHBORHOOD LOADING%' THEN 'Neighborhood Loading Zone'\n       WHEN UPPER(sign_description) LIKE '%HOTEL%' THEN 'Hotel Loading Zone'\n       ELSE 'Other Loading Zone' END AS zone_type,\n  ST_GEOGPOINT(lam*180/ACOS(-1), p4*180/ACOS(-1)) AS geom\nFROM s_p4"
      }
     ]
    }
   },
